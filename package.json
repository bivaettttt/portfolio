{
  "name": "timur-nadrshin-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm test",
    "test:browser": "playwright test",
    "format": "prettier --write src tests astro.config.mjs playwright.config.ts scripts",
    "format:check": "prettier --check src tests astro.config.mjs playwright.config.ts scripts",
    "media": "node scripts/optimize-screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
