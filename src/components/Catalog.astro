---
import {
  asset,
  categories,
  entries,
  projectRoute,
  url,
  type Category,
  type Lang,
} from "../lib/site";
const { lang, category } = Astro.props as { lang: Lang; category?: Category };
const ru = lang === "ru";
const visible = entries.filter((entry) => !entry.archived);
const countFormat = new Intl.PluralRules(lang);
const rows = category
  ? visible.filter((entry) => entry.category === category)
  : [];
const featured = rows.filter((entry) => entry.featured);
const rest = rows.filter((entry) => !entry.featured);
---

<header class="page-intro">
  {category && (
    <a class="breadcrumb" href={url("projects", lang)}>
      ← {ru ? "Все проекты" : "All projects"}
    </a>
  )}
  <p class="eyebrow">{ru ? "ПОРТФОЛИО" : "PORTFOLIO"}</p>
  <h1 transition:name={category ? "category-" + category : undefined}>
    {category ? categories[category].title[lang] : ru ? "Проекты" : "Projects"}
  </h1>
  <p class="lede">
    {category
      ? categories[category].desc[lang]
      : ru
        ? "От учебных моделей и практики до девяти личных систем. В каждом кейсе — задача, решения и подтверждённый результат."
        : "Course models, applied work and nine independent systems. Each case records the problem, decisions and verified outcomes."}
  </p>
</header>
{!category ? (
  <div class="folders">
    {(
      Object.entries(categories) as [Category, (typeof categories)[Category]][]
    ).map(([key, detail], index) => (
      <a class={"folder folder-" + key} href={url("projects/" + key, lang)}>
        <div class="folder-cover" aria-hidden="true">
          <div class="folder-back"></div>
          <div class="folder-paper">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="folder-front">
            <span>0{index + 1}</span>
          </div>
        </div>
        <div class="folder-text">
          <span class="eyebrow">
            {visible.filter((p) => p.category === key).length}{" "}
            {ru
              ? countFormat.select(
                  visible.filter((p) => p.category === key).length,
                ) === "few"
                ? "КЕЙСА"
                : "КЕЙСОВ"
              : "CASES"}
          </span>
          <h2 transition:name={"category-" + key}>{detail.title[lang]}</h2>
          <p>{detail.desc[lang]}</p>
        </div>
        <span class="folder-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ))}
  </div>
) : (
  <>
    {featured.length > 0 && (
      <section class="featured">
        <h2 class="section-label">
          {ru ? "Флагманские кейсы" : "Featured cases"}
        </h2>
        {featured.map((p) => (
          <a
            class={"feature project-" + p.id}
            href={url(projectRoute(p), lang)}
          >
            <div class="feature-copy">
              <p class="eyebrow" transition:name={"project-" + p.id}>
                {p.title[lang]}
              </p>
              <h3>{p.headline[lang]}</h3>
              <p>{p.description[lang]}</p>
              <strong>
                {ru ? "Открыть кейс" : "Read the case"}{" "}
                <span aria-hidden="true">↗</span>
              </strong>
            </div>
            {p.screens[0] && (
              <div class="feature-image">
                <img
                  src={asset(p.screens[0].path)}
                  srcset={[
                    ...p.screens[0].variants,
                    { path: p.screens[0].path, width: p.screens[0].width },
                  ]
                    .map((item) => asset(item.path) + " " + item.width + "w")
                    .join(", ")}
                  sizes="(max-width: 690px) 91vw, (max-width: 1370px) 54vw, 740px"
                  alt={p.screens[0].title[lang]}
                  width={p.screens[0].width}
                  height={p.screens[0].height}
                  loading="lazy"
                />
              </div>
            )}
          </a>
        ))}
      </section>
    )}
    <section
      class="project-list"
      aria-label={ru ? "Список кейсов" : "Case list"}
    >
      {featured.length > 0 && (
        <h2 class="section-label">
          {ru ? "Другие личные проекты" : "More independent projects"}
        </h2>
      )}
      {rest.map((p) => (
        <article class={"project-row project-" + p.id}>
          <a href={url(projectRoute(p), lang)}>
            <div>
              <h3 transition:name={"project-" + p.id}>{p.title[lang]}</h3>
              <p>{p.description[lang]}</p>
            </div>
            <span class="row-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </article>
      ))}
    </section>
  </>
)}
