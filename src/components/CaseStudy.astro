---
import {
  asset,
  categories,
  entries,
  mediaLink,
  projectRoute,
  url,
  type Lang,
  type Project,
} from "../lib/site";
const { lang, project: p } = Astro.props as { lang: Lang; project: Project };
const ru = lang === "ru";
const analysis = ru ? "Аналитический кейс" : "Analysis";
const showcase = ru ? "Демонстрация" : "Showcase";
const title = p.title[lang];
const caseSections = [
  {
    id: "context",
    label: ru ? "Контекст и роль" : "Context and role",
    texts: [p.context[lang], p.role[lang]],
  },
  {
    id: "design",
    label: ru ? "Модель и решения" : "Model and decisions",
    texts: [p.model[lang], p.decision[lang]],
  },
  {
    id: "proof",
    label: ru ? "Проверка и границы" : "Verification and scope",
    texts: [p.verification[lang], p.limits[lang]],
  },
];
const next = entries.filter((e) => e.category === p.category && !e.archived);
const nextCase = next[(next.indexOf(p) + 1) % next.length];
---

<div class={"case project-" + p.id}>
  <header class="case-heading">
    <a class="breadcrumb" href={url("projects/" + p.category, lang)}>
      ← {categories[p.category].title[lang]}
    </a>
    <div class="case-identity">
      <p class="eyebrow">
        {ru ? "КЕЙС СИСТЕМНОГО АНАЛИЗА" : "SYSTEM ANALYSIS CASE"}
      </p>
      <h1>{title}</h1>
      <p class="case-headline">{p.headline[lang]}</p>
      <p class="lede">{p.description[lang]}</p>
      <div class="actions">
        <a class="button primary" href="#analysis">
          {analysis} <span aria-hidden="true">↓</span>
        </a>
        <a class="button secondary" href="#showcase">
          {showcase} <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    {p.repo && (
      <div class="case-source">
        <a href={p.repo}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a href={p.repo + "/commit/" + p.sha}>
          <code>{p.sha?.slice(0, 7)}</code>
        </a>
      </div>
    )}
  </header>
  <div class="case-body" id="analysis">
    <aside class="case-side">
      <nav aria-label={ru ? "Оглавление кейса" : "Case contents"}>
        <p class="eyebrow">{ru ? "В ЭТОМ КЕЙСЕ" : "IN THIS CASE"}</p>
        {caseSections.map((s) => (
          <a href={"#" + s.id}>{s.label}</a>
        ))}
        {p.requirements.length > 0 && (
          <a href="#requirements">{ru ? "Требования" : "Requirements"}</a>
        )}
        {p.api.length > 0 && (
          <a href="#api">{ru ? "Контракты API" : "API contracts"}</a>
        )}
        <a href="#showcase">{showcase}</a>
      </nav>
    </aside>
    <div class="case-content">
      {caseSections.map((section, i) => (
        <section class="case-section" id={section.id}>
          <span class="step-number">0{i + 1}</span>
          <h2>{section.label}</h2>
          {section.texts.map((text) => (
            <p>{text}</p>
          ))}
          {section.id === "design" && (
            <div
              class="flow"
              aria-label={
                ru ? "Последовательность сценария" : "Scenario sequence"
              }
            >
              <h3>{ru ? "Сценарий" : "Scenario"}</h3>
              <ol>
                {p.flow.map((phase, index) => (
                  <li>
                    <span>{index + 1}</span>
                    {phase[lang]}
                  </li>
                ))}
              </ol>
            </div>
          )}
          {section.id === "design" && p.diagram && (
            <figure class="case-diagram">
              <a
                href={asset(p.diagram.path)}
                data-gallery
                data-title={p.diagram.title[lang]}
              >
                <img
                  src={asset(p.diagram.path)}
                  alt={p.diagram.title[lang]}
                  width={p.diagram.width}
                  height={p.diagram.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                <strong>{p.diagram.title[lang]}</strong>{" "}
                <a href={p.diagram.source}>
                  {ru ? "Исходник Mermaid" : "Mermaid source"} ↗
                </a>
              </figcaption>
            </figure>
          )}
        </section>
      ))}
      {p.requirements.length > 0 && (
        <section class="case-section" id="requirements">
          <span class="step-number">04</span>
          <h2>
            {ru
              ? "От требования к проверке"
              : "From requirement to verification"}
          </h2>
          <div class="artifact-list">
            {p.requirements.map((req) => (
              <details>
                <summary>
                  <code>{req.id}</code> {req.title[lang]}
                </summary>
                <dl>
                  <div>
                    <dt>{ru ? "Инвариант" : "Invariant"}</dt>
                    <dd>{req.rule[lang]}</dd>
                  </div>
                  <div>
                    <dt>{ru ? "Проверка" : "Verification"}</dt>
                    <dd>{req.check[lang]}</dd>
                  </div>
                </dl>
              </details>
            ))}
          </div>
        </section>
      )}
      {p.api.length > 0 && (
        <section class="case-section" id="api">
          <span class="step-number">05</span>
          <h2>{ru ? "Контракты API" : "API contracts"}</h2>
          <details class="api-details">
            <summary>
              {ru
                ? "Исследовать операции OpenAPI"
                : "Explore OpenAPI operations"}{" "}
              <span>· {p.api.length}</span>
            </summary>
            <label hidden class="api-filter">
              {ru ? "Фильтр по методу или пути" : "Filter by method or path"}
              <input type="search" placeholder="GET /api/…" />
            </label>
            <p hidden class="api-empty" role="status">
              {ru ? "Совпадений нет." : "No matching operations."}
            </p>
            <div class="endpoint-list">
              {p.api.map((op) => (
                <details data-endpoint={op.method + " " + op.path}>
                  <summary>
                    <strong>{op.method}</strong> <code>{op.path}</code>
                  </summary>
                  <p>{op.summary}</p>
                  <p>
                    {ru ? "Ответы" : "Responses"} · {op.responses.join(", ")}
                  </p>
                </details>
              ))}
            </div>
          </details>
        </section>
      )}
      {p.links.length > 0 && (
        <section class="case-section sources">
          <h2>{ru ? "Исходные материалы" : "Source materials"}</h2>
          <ul>
            {p.links.map((link) => (
              <li>
                <a href={mediaLink(link.url)}>
                  {link.label[lang]} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
  <section class="showcase" id="showcase">
    <header>
      <p class="eyebrow">
        {p.screens.length
          ? ru
            ? "РЕАЛЬНЫЕ МАТЕРИАЛЫ"
            : "ORIGINAL MATERIALS"
          : ru
            ? "РЕКОНСТРУКЦИЯ ПО ОПИСАНИЮ"
            : "DOCUMENTED RECONSTRUCTION"}
      </p>
      <h2>
        {p.category === "personal"
          ? ru
            ? "Демонстрация продукта"
            : "Product walkthrough"
          : ru
            ? "Результат работы"
            : "Project outcome"}
      </h2>
      <p>
        {p.screens.length
          ? ru
            ? "Откройте материал в полном размере, чтобы рассмотреть детали."
            : "Open each artifact at full size to examine the details."
          : p.limits[lang]}
      </p>
    </header>
    {p.screens.length > 0 ? (
      <div class="showcase-grid">
        {p.screens.map((screen, i) => (
          <figure class:list={[{ "showcase-main": i === 0 }]}>
            <a
              href={asset(screen.path)}
              data-gallery
              data-title={screen.title[lang]}
            >
              <img
                src={asset(screen.path)}
                srcset={
                  screen.preview
                    ? asset(screen.preview) +
                      " 640w, " +
                      asset(screen.path) +
                      " " +
                      screen.width +
                      "w"
                    : undefined
                }
                sizes={
                  screen.preview
                    ? i === 0
                      ? "(max-width: 690px) 90vw, 1150px"
                      : "(max-width: 690px) 90vw, 580px"
                    : undefined
                }
                alt={screen.title[lang]}
                width={screen.width}
                height={screen.height}
                loading="lazy"
                decoding="async"
              />
              <span class="zoom-icon" aria-hidden="true">
                ↗
              </span>
            </a>
            <figcaption>
              <strong>{screen.title[lang]}</strong>
              {screen.source && (
                <a href={screen.source}>{ru ? "Источник" : "Source"} ↗</a>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="flow">
        <h3>{ru ? "Маршрут" : "Flow"}</h3>
        <ol>
          {p.flow.map((phase, index) => (
            <li>
              <span>{index + 1}</span>
              {phase[lang]}
            </li>
          ))}
        </ol>
      </div>
    )}
    {p.video && (
      <details class="video">
        <summary>{ru ? "Запись сценария" : "Recorded walkthrough"}</summary>
        <video
          controls
          preload="none"
          poster={asset(p.screens[0]!.path)}
          muted
          playsinline
          src={asset(p.video)}
          aria-label={
            ru
              ? "Запись сценария без звукового сопровождения"
              : "Silent recorded walkthrough"
          }
        ></video>
        <p>
          {ru
            ? "Без звукового сопровождения. Основные шаги описаны выше."
            : "Silent recording. The key steps are described above."}
        </p>
      </details>
    )}
  </section>
  {nextCase && nextCase.id !== p.id && (
    <a class="next-case" href={url(projectRoute(nextCase), lang)}>
      <div>
        <span class="eyebrow">{ru ? "СЛЕДУЮЩИЙ КЕЙС" : "NEXT CASE"}</span>
        <strong>{nextCase.title[lang]}</strong>
      </div>
      <span aria-hidden="true">↗</span>
    </a>
  )}
  {p.screens.length > 0 && (
    <dialog class="image-dialog" aria-labelledby="gallery-title">
      <div class="dialog-head">
        <h2 id="gallery-title"></h2>
        <div>
          <button
            type="button"
            data-zoom="-1"
            aria-label={ru ? "Уменьшить" : "Zoom out"}
          >
            −
          </button>
          <button
            type="button"
            data-zoom="1"
            aria-label={ru ? "Увеличить" : "Zoom in"}
          >
            +
          </button>
          <button
            type="button"
            data-close
            aria-label={ru ? "Закрыть" : "Close"}
          >
            ×
          </button>
        </div>
      </div>
      <div class="image-stage" tabindex="0">
        <img alt="" />
      </div>
    </dialog>
  )}
</div>
<script>
  document.addEventListener("astro:page-load", () => {
    const filter =
      document.querySelector<HTMLInputElement>(".api-filter input");
    const empty = document.querySelector<HTMLElement>(".api-empty");
    const endpoints = [
      ...document.querySelectorAll<HTMLElement>("[data-endpoint]"),
    ];
    filter?.closest("label")?.removeAttribute("hidden");
    filter?.addEventListener("input", () => {
      let matches = 0;
      for (const endpoint of endpoints) {
        endpoint.hidden = !endpoint.dataset.endpoint
          ?.toLowerCase()
          .includes(filter.value.trim().toLowerCase());
        if (!endpoint.hidden) matches++;
      }
      if (empty) empty.hidden = matches > 0;
    });
    const dialog = document.querySelector<HTMLDialogElement>(".image-dialog");
    const image = dialog?.querySelector<HTMLImageElement>("img");
    const title = dialog?.querySelector("h2");
    if (!dialog || !image || !title) return;
    let zoom = 100;
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-gallery]",
    )) {
      link.onclick = (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        title.textContent = link.dataset.title ?? "";
        image.src = link.href;
        image.alt = link.dataset.title ?? "";
        image.style.width = "100%";
        zoom = 100;
        dialog.showModal();
        dialog.querySelector(".image-stage")?.scrollTo(0, 0);
      };
    }
    dialog.querySelector<HTMLButtonElement>("[data-close]")!.onclick = () =>
      dialog.close();
    for (const button of dialog.querySelectorAll<HTMLButtonElement>(
      "[data-zoom]",
    )) {
      button.onclick = () => {
        zoom = Math.min(
          250,
          Math.max(75, zoom + 25 * Number(button.dataset.zoom)),
        );
        image.style.width = zoom + "%";
      };
    }
  });
</script>
