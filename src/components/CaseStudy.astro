---
import CaseNavigation from "./CaseNavigation.astro";
import ImageGallery from "./ImageGallery.astro";
import Showcase from "./Showcase.astro";
import {
  asset,
  categories,
  entries,
  mediaLink,
  projectRoute,
  url,
  type Lang,
  type Project,
} from "../lib/site";
const { lang, project: p } = Astro.props as { lang: Lang; project: Project };
const ru = lang === "ru";
const analysis = ru ? "Аналитический кейс" : "Analysis";
const showcase = ru ? "Демонстрация" : "Showcase";
const title = p.title[lang];
const engineeringLabels = {
  actors: ru
    ? "Участники и ответственность"
    : "Stakeholders and responsibilities",
  data: ru ? "Модель данных" : "Data model",
  quality: ru ? "Требования к качеству" : "Quality requirements",
  exceptions: ru ? "Исключения и риски" : "Exceptions and risks",
};
const caseSections = [
  {
    id: "context",
    label: ru ? "Контекст и роль" : "Context and role",
    texts: [p.context[lang], p.role[lang]],
  },
  {
    id: "design",
    label: ru ? "Модель и решения" : "Model and decisions",
    texts: [p.model[lang], p.decision[lang]],
  },
  {
    id: "proof",
    label: ru ? "Проверка и границы" : "Verification and scope",
    texts: [p.verification[lang], p.limits[lang]],
  },
];
const peers = entries.filter(
  (entry) => entry.category === p.category && !entry.archived,
);
const position = peers.indexOf(p);
const previous = peers[position - 1];
const next = peers[position + 1];
const chapters = [
  ...caseSections,
  ...(p.caseNotes
    ? [
        {
          id: "process",
          label: ru ? "Процесс и решения" : "Process and trade-offs",
        },
      ]
    : []),
  ...(p.engineering.length
    ? [
        {
          id: "engineering",
          label: ru ? "Границы и инварианты" : "Boundaries and invariants",
        },
      ]
    : []),
  ...(p.requirements.length
    ? [{ id: "requirements", label: ru ? "Требования" : "Requirements" }]
    : []),
  ...(p.api.length ? [{ id: "api", label: "OpenAPI" }] : []),
  { id: "showcase", label: showcase },
];
---

<div class={"case project-" + p.id}>
  <CaseNavigation {lang} project={p} {chapters} />
  <header class="case-heading">
    <div class="case-identity">
      <p class="eyebrow">
        {ru ? "КЕЙС СИСТЕМНОГО АНАЛИЗА" : "SYSTEM ANALYSIS CASE"}
      </p>
      <h1 transition:name={"project-" + p.id}>{title}</h1>
      <p class="case-headline">{p.headline[lang]}</p>
      <p class="lede">{p.description[lang]}</p>
      <div class="actions">
        <a class="button primary" href="#analysis">
          {analysis} <span aria-hidden="true">↓</span>
        </a>
        <a class="button secondary" href="#showcase">
          {showcase} <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    {p.repo && (
      <div class="case-source">
        <a href={p.repo}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a href={p.repo + "/commit/" + p.sha}>
          <code>{p.sha?.slice(0, 7)}</code>
        </a>
      </div>
    )}
  </header>
  <div class="case-body" id="analysis">
    <aside class="case-side">
      <nav aria-label={ru ? "Оглавление кейса" : "Case contents"}>
        {chapters.map((chapter) => (
          <a href={"#" + chapter.id}>{chapter.label}</a>
        ))}
      </nav>
    </aside>
    <div class="case-content">
      {caseSections.map((section) => (
        <section class="case-section" id={section.id}>
          <h2>{section.label}</h2>
          {section.texts.map((text) => (
            <p>{text}</p>
          ))}
          {section.id === "design" && (
            <div
              class="flow"
              aria-label={
                ru ? "Последовательность сценария" : "Scenario sequence"
              }
            >
              <h3>{ru ? "Сценарий" : "Scenario"}</h3>
              <ol>
                {p.flow.map((phase, index) => (
                  <li>
                    <span>{index + 1}</span>
                    {phase[lang]}
                  </li>
                ))}
              </ol>
            </div>
          )}
          {section.id === "design" && p.diagram && (
            <figure class="case-diagram">
              <a
                href={asset(p.diagram.path)}
                data-gallery
                data-title={p.diagram.title[lang]}
              >
                <img
                  src={asset(p.diagram.path)}
                  alt={p.diagram.title[lang]}
                  width={p.diagram.width}
                  height={p.diagram.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                <strong>{p.diagram.title[lang]}</strong>{" "}
                {p.diagram.source && (
                  <a href={p.diagram.source}>
                    {ru ? "Исходник Mermaid" : "Mermaid source"} ↗
                  </a>
                )}
                {p.diagram.caption && <p>{p.diagram.caption[lang]}</p>}
              </figcaption>
            </figure>
          )}
        </section>
      ))}
      {p.caseNotes && (
        <section class="case-section case-process" id="process">
          <h2>{ru ? "Процесс и решения" : "Process and trade-offs"}</h2>
          <p>{p.caseNotes.trigger[lang]}</p>
          <div class="process-evidence">
            <div>
              <h3>{ru ? "Альтернативная ветвь" : "Alternative path"}</h3>
              <p>{p.caseNotes.exception[lang]}</p>
            </div>
            <div>
              <h3>{ru ? "Компромисс" : "Trade-off"}</h3>
              <p>{p.caseNotes.tradeoff[lang]}</p>
            </div>
            <div>
              <h3>{ru ? "Признак приёмки" : "Acceptance evidence"}</h3>
              <p>{p.caseNotes.acceptance[lang]}</p>
            </div>
          </div>
        </section>
      )}
      {p.engineering.length > 0 && (
        <section class="case-section" id="engineering">
          <h2>{ru ? "Границы и инварианты" : "Boundaries and invariants"}</h2>
          <dl class="engineering">
            {p.engineering.map((item) => (
              <div>
                <dt>{engineeringLabels[item.id]}</dt>
                <dd>{item.text[lang]}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      {p.requirements.length > 0 && (
        <section class="case-section" id="requirements">
          <h2>
            {ru
              ? "От требования к проверке"
              : "From requirement to verification"}
          </h2>
          <div class="artifact-list">
            {p.requirements.map((req) => (
              <details>
                <summary>
                  <code>{req.id}</code> {req.title[lang]}
                </summary>
                {req.retrospective && (
                  <p class="pad">
                    {ru
                      ? "Ретроспективная формализация для портфолио на основе подтверждённых материалов."
                      : "Retrospective portfolio formalization based on the verified materials."}
                  </p>
                )}
                <dl>
                  {req.condition && (
                    <div>
                      <dt>{ru ? "Предусловия" : "Preconditions"}</dt>
                      <dd>{req.condition[lang]}</dd>
                    </div>
                  )}
                  <div>
                    <dt>{ru ? "Инвариант" : "Invariant"}</dt>
                    <dd>{req.rule[lang]}</dd>
                  </div>
                  <div>
                    <dt>{ru ? "Проверка" : "Verification"}</dt>
                    <dd>{req.check[lang]}</dd>
                  </div>
                  {req.constraints && (
                    <div>
                      <dt>{ru ? "Ограничения" : "Constraints"}</dt>
                      <dd>{req.constraints[lang]}</dd>
                    </div>
                  )}
                  <div class="requirement-links">
                    <a href="#process">
                      {ru ? "Бизнес-процесс" : "Business process"}
                    </a>
                    {req.implementation && (
                      <a href={req.implementation}>
                        {ru ? "Реализация" : "Implementation"} ↗
                      </a>
                    )}
                    {req.testSource && (
                      <a href={req.testSource}>
                        {ru ? "Браузерные проверки" : "Browser verification"} ↗
                      </a>
                    )}
                  </div>
                </dl>
              </details>
            ))}
          </div>
        </section>
      )}
      {p.api.length > 0 && (
        <section class="case-section" id="api">
          <h2>{ru ? "Контракты API" : "API contracts"}</h2>
          <details class="api-details">
            <summary>
              {ru
                ? "Исследовать операции OpenAPI"
                : "Explore OpenAPI operations"}{" "}
              <span>· {p.api.length}</span>
            </summary>
            <label hidden class="api-filter">
              {ru ? "Фильтр по методу или пути" : "Filter by method or path"}
              <input type="search" placeholder="GET /api/…" />
            </label>
            <p hidden class="api-empty" role="status">
              {ru ? "Совпадений нет." : "No matching operations."}
            </p>
            <div class="endpoint-list">
              {p.api.map((op) => (
                <details data-endpoint={op.method + " " + op.path}>
                  <summary>
                    <strong>{op.method}</strong> <code>{op.path}</code>
                  </summary>
                  <p>{op.summary}</p>
                  <p>
                    {ru ? "Ответы" : "Responses"} · {op.responses.join(", ")}
                  </p>
                </details>
              ))}
            </div>
          </details>
        </section>
      )}
      {p.links.length > 0 && (
        <section class="case-section sources">
          <h2>{ru ? "Исходные материалы" : "Source materials"}</h2>
          <ul>
            {p.links.map((link) => (
              <li>
                <a href={mediaLink(link.url)}>
                  {link.label[lang]} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
  <Showcase {lang} project={p} />
  <nav
    class="case-neighbors"
    aria-label={ru ? "Навигация по категории" : "Category navigation"}
  >
    <div>
      {previous && (
        <a rel="prev" href={url(projectRoute(previous), lang)}>
          <span>{ru ? "Предыдущий проект" : "Previous project"}</span>
          <strong>← {previous.title[lang]}</strong>
        </a>
      )}
    </div>
    <a class="category-return" href={url("projects/" + p.category, lang)}>
      {categories[p.category].title[lang]}
    </a>
    <div>
      {next && (
        <a rel="next" href={url(projectRoute(next), lang)}>
          <span>{ru ? "Следующий проект" : "Next project"}</span>
          <strong>{next.title[lang]} →</strong>
        </a>
      )}
    </div>
  </nav>
  {(p.screens.length || p.diagram) && <ImageGallery {lang} />}
</div>
<script>
  document.addEventListener("astro:page-load", () => {
    const filter =
      document.querySelector<HTMLInputElement>(".api-filter input");
    const empty = document.querySelector<HTMLElement>(".api-empty");
    const endpoints = [
      ...document.querySelectorAll<HTMLElement>("[data-endpoint]"),
    ];
    filter?.closest("label")?.removeAttribute("hidden");
    filter?.addEventListener("input", () => {
      let matches = 0;
      for (const endpoint of endpoints) {
        endpoint.hidden = !endpoint.dataset.endpoint
          ?.toLowerCase()
          .includes(filter.value.trim().toLowerCase());
        if (!endpoint.hidden) matches++;
      }
      if (empty) empty.hidden = matches > 0;
    });
  });
</script>
