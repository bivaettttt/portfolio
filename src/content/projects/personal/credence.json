  "context": {
    "ru": "Уточнение данных не должно оставлять старую оценку основанием нового решения.",
    "en": "A clarification must not leave a stale assessment as the basis for the next decision."
  },
  "model": {
    "ru": "Заявка, снимок материалов, оценка, решение и предложение хранятся отдельно в PostgreSQL. FastAPI ограничивает переходы по ролям.",
    "en": "Application, evidence snapshot, assessment, decision and offer are separate PostgreSQL records. FastAPI constrains transitions by role."
  },
  "decision": {
    "ru": "Редакция и блокировка защищают конкурентное решение; квитанция воспроизводит результат повторной команды.",
    "en": "Revisions and row locks guard competing decisions. A receipt replays the result of a repeated command."
  },
  "verification": {
    "ru": "Лаборатория сверяет API и данные PostgreSQL. Браузер покрывает запрос уточнений и принятие предложения.",
    "en": "The lab checks HTTP and PostgreSQL state. The browser covers clarification and offer acceptance."
  },
  "limits": {
    "ru": "Учебная объяснимая модель оценки, синтетические данные.",
    "en": "Educational explainable score and synthetic data."
  },
